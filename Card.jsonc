{
  "name": "Card",
  "description": "Entidade colecionável lore-first do DeckVerse OS. Estatísticas numéricas de combate foram removidas do contrato canônico.",
  "schema": {
    "name": { "type": "string", "required": true },
    "card_id": { "type": "string", "required": false },
    "collection_id": { "type": "string", "required": true },
    "entity_type": { "type": "string", "enum": ["character", "boss", "item"], "required": true },
    "rarity": { "type": "string", "required": false },
    "role": { "type": "string", "required": false },
    "synopsis": { "type": "string", "required": true, "description": "Sinopse editorial curta com limite definido por entity_type." },
    "description": { "type": "string", "required": false, "description": "Lore estendida opcional; não substitui synopsis." },
    "img_oficial": { "type": "string", "required": false },
    "img_custom": { "type": "string", "required": false },
    "image_url": { "type": "string", "required": false },
    "version": { "type": "string", "required": false },
    "tags": { "type": "array", "items": { "type": "string" }, "required": false },
    "natures": { "type": "array", "items": { "type": "string" }, "required": false },
    "personality": { "type": "string", "required": false },
    "identity": { "type": "string", "required": false },
    "origin": { "type": "string", "required": false },
    "narrative_function": { "type": "string", "required": false },
    "character_class": { "type": "string", "required": false },
    "power_type": { "type": "string", "required": false },
    "franchise_fields": { "type": "object", "required": false }
  }
}
