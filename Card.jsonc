{
  "name": "Card",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Character name"
    },
    "card_id": {
      "type": "string",
      "description": "Smart CID: [ORIGEM]-[TIPO]-[RARIDADE]-[NUM] (ex: NAR-CHR-SSR-005)"
    },
    "collection_id": {
      "type": "string",
      "description": "Collection code (ex: NAR, MVC, AOT)"
    },
    "img_oficial": {
      "type": "string",
      "description": "URL da imagem oficial/padr\u00e3o do sistema"
    },
    "img_custom": {
      "type": "string",
      "description": "URL de imagem customizada (skin alternativa ou resultado de Laborat\u00f3rio). Se preenchido, sobrep\u00f5e img_oficial."
    },
    "rarity": {
      "type": "string",
      "enum": [
        "C",
        "UC",
        "R",
        "SR",
        "SSR",
        "UR",
        "LR",
        "MR",
        "BOSS",
        "ANOMALIA"
      ],
      "description": "Card rarity tier"
    },
    "role": {
      "type": "string",
      "enum": [
        "DPS",
        "Tank",
        "Support",
        "Healer",
        "Assassin",
        "Mage",
        "Berserker",
        "Sniper",
        "Invoker",
        "Bard"
      ],
      "description": "Character archetype / class"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Male",
        "Female",
        "Unknown",
        "Other"
      ],
      "description": "Character gender"
    },
    "element": {
      "type": "string",
      "enum": [
        "Fire",
        "Water",
        "Earth",
        "Wind",
        "Lightning",
        "Shadow",
        "Light"
      ],
      "description": "Elemental affinity"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Synergy tags (ex: Uchihas, Vingadores, X-Men). Multiple allowed."
    },
    "mag_source": {
      "type": "string",
      "description": "Energy/power source (ex: Chakra, Cursed Energy, Mana)"
    },
    "mag": {
      "type": "number",
      "description": "MAG (magic/energy power) stat",
      "default": 0
    },
    "attack": {
      "type": "number",
      "description": "Base attack stat"
    },
    "defense": {
      "type": "number",
      "description": "Base defense stat"
    },
    "speed": {
      "type": "number",
      "description": "Base speed stat"
    },
    "hp": {
      "type": "number",
      "description": "Base HP stat"
    },
    "skills": {
      "type": "array",
      "description": "List of character abilities",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "Active",
              "Passive",
              "Ultimate"
            ]
          }
        }
      }
    },
    "lore": {
      "type": "string",
      "description": "Character backstory / flavor text"
    },
    "version": {
      "type": "string",
      "description": "Card version label (ex: 'Summer Alt', 'Battle Form', 'Classic')",
      "default": "Classic"
    },
    "is_boss": {
      "type": "boolean",
      "description": "True if this is a Boss/Event card",
      "default": false
    },
    "evolution_stage": {
      "type": "number",
      "description": "Evolution stage (1-3)",
      "default": 1
    },
    "xp": {
      "type": "number",
      "description": "Card XP for border progression",
      "default": 0
    },
    "level": {
      "type": "number",
      "description": "Card level (1-100)",
      "default": 1
    }
  },
  "required": [
    "name",
    "card_id",
    "rarity",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}