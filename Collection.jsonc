{
  "name": "Collection",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Unique collection code (e.g., JJK-0001)"
    },
    "name": {
      "type": "string",
      "description": "Collection name (e.g., Jujutsu Kaisen)"
    },
    "type": {
      "type": "string",
      "enum": ["manual", "smart"],
      "default": "manual",
      "description": "Smart collections compute cards dynamically via rule filters"
    },
    "rule": {
      "type": "object",
      "description": "Rule definition for smart collections (e.g. archetype_ids CONTAINS 'estrategico')"
    },
    "description": {
      "type": "string",
      "description": "Collection description"
    },
    "image_url": {
      "type": "string",
      "description": "Background image for collection tile"
    }
  },
  "required": [
    "code",
    "name"
  ]
}