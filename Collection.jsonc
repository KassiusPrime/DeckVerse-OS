{
  "name": "Collection",
  "type": "object",
  "properties": {
    "code": { "type": "string", "description": "Código canônico da coleção" },
    "name": { "type": "string", "description": "Nome oficial da coleção" },
    "type": { "type": "string", "enum": ["manual", "smart"], "default": "manual" },
    "rule": { "type": "object", "description": "Regra de agrupamento para coleções inteligentes" },
    "synopsis": { "type": "string", "description": "Panorama editorial e atmosférico de 350–400 caracteres." },
    "description": { "type": "string", "description": "Lore/contexto estendido opcional." },
    "image_url": { "type": "string", "description": "Capa canônica da coleção" }
  },
  "required": ["code", "name", "synopsis"]
}
