        "Weapon",
        "Armor",
        "Relic",
        "Accessory",
        "Consumable"
      ],
      "description": "Item category"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "Recruit",
        "Adept",
        "Elite",
        "Champion",
        "Sovereign",
        "Ascendant"
      ]
    },
    "atk_bonus": {
      "type": "number",
      "default": 0
    },
    "def_bonus": {
      "type": "number",
      "default": 0
    },
    "hp_bonus": {
      "type": "number",
      "default": 0
    },
    "spd_bonus": {
      "type": "number",
      "default": 0
    },
    "role_bonus": {
      "type": "string",
