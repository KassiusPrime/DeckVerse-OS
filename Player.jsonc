{
  "name": "Player",
  "type": "object",
  "properties": {
    "discord_id": {
      "type": "string",
      "description": "Player's Discord user ID"
    },
    "username": {
      "type": "string",
      "description": "Player username (e.g., Vincent)"
    },
    "gems": {
      "type": "number",
      "description": "Current gem balance",
      "default": 0
    },
    "gold": {
      "type": "number",
      "description": "Current gold balance",
      "default": 0
    },
    "level": {
      "type": "number",
      "description": "Player level",
      "default": 1
    },
    "wins": {
      "type": "number",
      "description": "Total wins",
      "default": 0
    },
    "losses": {
      "type": "number",
      "description": "Total losses",
      "default": 0
    },
    "avatar_url": {
      "type": "string",
      "description": "Player avatar image URL"
    }
  },
  "required": [
    "discord_id",
    "username"
  ]
}