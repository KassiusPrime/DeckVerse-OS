rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && request.auth.token.email == 'cassianokaique9@gmail.com';
    }

    function canManageCatalog() {
      return isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // Every Firebase account owns one profile document. Regular users can edit
    // only non-privileged fields; the authenticated Owner token controls roles.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isOwner());
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.status == 'active' &&
        (
          (isOwner() && (request.resource.data.role == 'admin' || request.resource.data.role == 'owner')) ||
          (!isOwner() && request.resource.data.role == 'user')
        );
      allow update: if isOwner() || (
        isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.email == resource.data.email
      );
      allow delete: if isOwner();
    }

    match /collections/{collectionCode} {
      allow read: if true;
      allow write: if canManageCatalog();
    }

    match /dynamicRegistry/{canonicalCode} {
      allow read: if true;
      allow write: if canManageCatalog();
    }

    match /characters/{characterId} {
      allow read: if true;
      allow write: if canManageCatalog();
    }

    match /items/{itemId} {
      allow read: if true;
      allow write: if canManageCatalog();
    }

    // Legacy-only during migration. New public media/catalog paths no longer
    // create Boss entities, but Owner migration must be allowed to delete them.
    match /bosses/{bossId} {
      allow read: if true;
      allow write: if canManageCatalog();
    }

    match /lore/{loreId} {
      allow read: if true;
      allow write: if canManageCatalog();
    }

    match /mediaIndex/{mediaId} {
      allow read: if true;
      allow write: if canManageCatalog();
    }

    match /systemMigrations/{migrationId} {
      allow read, write: if isOwner();
    }
  }
}
