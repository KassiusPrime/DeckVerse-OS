{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/discord/spawn-tick",
      "schedule": "*/5 * * * *"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
